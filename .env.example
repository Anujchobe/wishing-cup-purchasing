# AI settings. Copy this file to .env and fill it in.
# Leave LLM_API_KEY empty to run with no AI: the app uses text matching instead.
#
# Any OpenAI-compatible endpoint works. Change provider or model by editing only this file.
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1   (any non-empty key, e.g. ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
